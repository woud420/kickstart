{
  "name": "kickstart-website",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "engines": {
    "bun": ">=1.4.4 <2"
  },
  "scripts": {
    "check": "bun run typecheck && bun run test",
    "dev": "alchemy dev",
    "deploy": "alchemy deploy --adopt",
    "deploy:release": "alchemy deploy --stage prod --adopt --yes",
    "prepare-release": "bun run scripts/render-release-config.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@alchemy.run/cloudflare": "2.0.0-beta.87",
    "@cloudflare/workers-types": "^5.20261125.1",
    "@effect/platform-bun": "4.1.5",
    "@effect/platform-node": "4.1.5",
    "@types/bun": "^1.4.5",
    "alchemy": "2.0.0-beta.87",
    "effect": "4.1.5",
    "typescript": "^7.0.2",
    "vitest": "^5.1.2",
    "wrangler": "^4.168.0"
  }
}
